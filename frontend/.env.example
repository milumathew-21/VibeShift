# VibeShift Frontend Environment Configuration
# Copy this file to .env and adjust values as needed.

# FastAPI Backend Base URL (default: http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# API Mode:
# - "live": Connects directly to the FastAPI backend at VITE_API_BASE_URL (default)
# - "mock": Runs in standalone deterministic Demo/Mock Mode (no backend required)
VITE_API_MODE=live

